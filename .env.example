# Copy to .env.local for local runs. On Vercel add these under Project -> Settings -> Environment Variables.

# AI (free): https://aistudio.google.com/apikey   (optional: GROQ_API_KEY from https://console.groq.com)
GEMINI_API_KEY=

# Database (free): Vercel -> Storage -> Create -> Neon. Vercel fills DATABASE_URL for you.
# Without it the app still runs, but data lives in memory and resets.
DATABASE_URL=

# Password for /admin dashboard (choose your own)
ADMIN_PASSWORD=change-me
